{
  "name": "dsh-koi-media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "图片库存、视频首帧与带图消息自动识图（读取前限流，库存路径受限）",
  "main": "./lib/index.js",
