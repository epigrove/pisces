{
  "name": "dsh-koi-lexicon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "People, things, and impressions: the agent's subjective world, with typed decay.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "pisces": {
      "category": "memory",
      "label": "印象/词条",
      "desc": "对人的印象、对物的定义与好恶；描述三态 + 印象求和，默认曲线不分类"
    }
  },
  "dependencies": {
    "dsh-koi-decay": "workspace:*",
    "dsh-pisces-config": "workspace:*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
